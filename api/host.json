{
    "version": "2.0",
    "functionTimeout": "00:10:00",
    "extensions": {
        "queues": {
            "batchSize": 1,
            "newBatchThreshold": 0,
            "maxDequeueCount": 2,
            "visibilityTimeout": "00:00:30",
            "maxPollingInterval": "00:00:02"
        }
    },
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        }
    }
}